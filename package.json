{
  "name": "early-fun",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/build-api.mjs && node scripts/build-mock.mjs && vite build && node scripts/dev-server.cjs",
    "build:api": "node scripts/build-api.mjs",
    "build": "node scripts/build-api.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan": "node scripts/build-api.mjs && node --env-file=.env scripts/worker.cjs",
    "probe": "node scripts/build-api.mjs && node --env-file=.env scripts/probe.cjs",
    "offline": "node scripts/toggle-offline.mjs on",
    "online": "node scripts/toggle-offline.mjs off",
    "postinstall": "node scripts/gen-assets.mjs",
    "make:og": "tsx scripts/make-og.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "satori": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}